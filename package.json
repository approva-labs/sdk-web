{
  "name": "@approva/web-sdk",
  "version": "0.1.0",
  "description": "Approva Web SDK for on-chain authorization.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run typecheck && npm run build",
    "link:global": "npm run build && npm link",
    "unlink:global": "npm unlink -g @approva/web-sdk",
    "relink": "npm unlink -g @approva/web-sdk && npm run build && npm link",
    "pack:local": "npm run build && npm pack",
    "verify": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "qrcode": "^1.5.4",
    "socket.io-client": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.5",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
